# Template for the local-only .env (which is gitignored). Copy with
# `cp .env.example .env`, then fill values with op:// pointers resolved by
# `op run` at launch. Keep real item names in .env only — this file ships to
# the public repo, so every reference below is fake.
#
# Format: NAME=op://<Vault>/<Item Name>/<Field>
# Leave entries empty until an experiment needs them — `op run` tries to
# resolve every non-empty op:// reference at launch.

GOOGLE_PHOTOS_CLIENT_ID=
GOOGLE_PHOTOS_CLIENT_SECRET=
# GOOGLE_PHOTOS_CLIENT_ID=op://VaultName/item-name/client-id
