# This file is COMMITTED and holds only 1Password op:// pointers — never raw
# values. `pnpm dev` / `pnpm build` run it through `op run`, which resolves
# each reference at launch time. Unset references stay empty; the site runs
# fine without any secrets (`pnpm dev:plain` skips op entirely).
#
# Format: NAME=op://<Vault>/<Item Name>/<Field>
# Example: GOOGLE_CLIENT_SECRET=op://Lab/google-oauth/client-secret

GOOGLE_PHOTOS_CLIENT_ID=
GOOGLE_PHOTOS_CLIENT_SECRET=
